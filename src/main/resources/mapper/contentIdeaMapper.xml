<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jjy.contents_lab.mapper.ContentIdeaMapper">
    <resultMap id="PromptTemplateMap" type="com.jjy.contents_lab.dto.PromptTemplateDto">
        <id property="id" column="id"/>
        <result property="category" column="category"/>
        <result property="targetSize" column="target_size"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="promptText" column="prompt_text"/>
        <result property="isVisible" column="is_visible"/>
        <result property="createDate" column="create_date"/>
    </resultMap>

    <select id="getPromptList" parameterType="map" resultMap="PromptTemplateMap">
        SELECT *
        FROM prompt_templates
        <where>
            <if test="targetSize != 'ALL'">
                AND target_size= #{targetSize}
            </if>
        </where>
        LIMIT #{size} OFFSET #{offset}
    </select>
</mapper>