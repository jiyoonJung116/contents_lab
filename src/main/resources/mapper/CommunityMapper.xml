<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jjy.contents_lab.mapper.CommunityMapper">
    <resultMap id="CommunityMap" type="com.jjy.contents_lab.dto.CommunityDto">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="mediaUrl" column="media_url"/>
        <result property="viewCount" column="view_count"/>
        <result property="createDate" column="create_date"/>
        <result property="updateDate" column="update_date"/>
        <result property="commentCount" column="comment_count"/>
        <result property="userName" column="user_name"/>
    </resultMap>

    <select id="getCommunityList" parameterType="map" resultMap="CommunityMap">
        SELECT 
            c.*, 
            u.user_name,
           COUNT(cmt.id) AS comment_count
        FROM community c
        LEFT JOIN comments cmt 
         ON c.id = cmt.community_id
        LEFT JOIN users u 
         ON c.user_id = u.id
        GROUP BY c.id
        ORDER BY c.create_date DESC
        LIMIT #{size} OFFSET #{offset}
    </select>
</mapper>