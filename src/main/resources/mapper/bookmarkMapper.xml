<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jjy.contents_lab.mapper.BookmarkMapper">
    <resultMap id="UserBookmarkMap" type="com.jjy.contents_lab.dto.UserBookmarkDto">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="targetId" column="target_id"/>
        <result property="targetType" column="target_type"/>
        <result property="createDate" column="create_date"/>
        <result property="targetSize" column="target_size"/>
        <result property="title" column="title"/>
        <result property="promptText" column="prompt_text"/>
    </resultMap>

    <select id="getBookmarkList" parameterType="map" resultMap="UserBookmarkMap">
        SELECT 
            ub.id,
            pt.target_size, 
            pt.title, 
            pt.prompt_text
        FROM user_bookmark ub
        INNER JOIN prompt_templates pt
        ON ub.target_id = pt.id
        WHERE user_id = #{userId}
        LIMIT #{size} OFFSET #{offset}
    </select>

    <insert id="saveBookmark" parameterType="com.jjy.contents_lab.dto.UserBookmarkDto" useGeneratedKeys="true" keyProperty="id">
        INSERT user_bookmark 
        SET user_id = #{userId},
            target_id = #{targetId},
            target_type = #{targetType},
            create_date = NOW()
    </insert> 

    <delete id="deleteBookmark">
        DELETE FROM user_bookmark 
        WHERE id = #{bookmarkId}
         AND user_id = #{userId}
    </delete>
</mapper>